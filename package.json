{
  "name": "@todovue/tv-menu",
  "private": false,
  "author": "Cristhian Daza",
  "description": "A Vue menu component with modern design and easy customization.",
  "license": "MIT",
  "version": "1.1.5",
  "type": "module",
  "homepage": "https://ui.todovue.blog/menu",
  "repository": {
    "name": "@todovue/tv-menu",
    "type": "git",
    "url": "git+https://github.com/TODOvue/tv-menu.git"
  },
  "bugs": {
    "url": "https://github.com/TODOvue/tv-menu/issues"
  },
  "keywords": [
    "todovue",
    "front-end",
    "web",
    "vue",
    "vuejs",
    "vue-js",
    "menu",
    "show-menu",
    "vue-menu",
    "vue-menu-component"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "dist/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/tv-menu.es.js",
      "require": "./dist/tv-menu.cjs.js"
    },
    "./style.css": "./dist/tv-menu.css",
    "./nuxt": "./nuxt.js",
    "./demo": {
      "import": "./src/demo/Demo.vue"
    }
  },
  "main": "dist/tv-menu.cjs.js",
  "module": "dist/tv-menu.es.js",
  "types": "dist/tv-menu.d.ts",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "nuxt.js",
    "src"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "cp README.md public/ && cp CHANGELOG.md public/ && VITE_BUILD_TARGET=demo vite build"
  },
  "peerDependencies": {
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@todovue/tv-demo": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.3",
    "sass": "^1.97.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@todovue/tv-search": "^1.2.1"
  }
}
